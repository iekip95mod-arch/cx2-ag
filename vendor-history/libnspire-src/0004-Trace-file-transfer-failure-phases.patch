 		goto end;
 
@@ -106,10 +124,14 @@ int nspire_file_read(nspire_handle_t *handle, const char *path,
 	if ( (ret = data_scan("h000000000w", buffer, len, NULL, &data_len)) )
 		goto end;
 
+	phase = "ready";
