--- a/src/services/file.c
+++ b/src/services/file.c
@@ -28,6 +28,8 @@ int nspire_file_write(nspire_handle_t *handle, const char *path,
 	size_t len;
 	uint8_t buffer[sizeof(struct packet)], *ptr = data;
 	uint16_t result;
+	const size_t total = size;
