 	if (size > UINT32_MAX)
 		return -NSPIRE_ERR_INVALID;
 
@@ -38,9 +40,13 @@ int nspire_file_write(nspire_handle_t *handle, const char *path,
 			0x0301, path, (uint32_t)size)) )
 		goto end;
 
