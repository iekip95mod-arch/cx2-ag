 	return service_finish(handle, ret);
 }
 
@@ -81,6 +93,8 @@ int nspire_file_read(nspire_handle_t *handle, const char *path,
 	uint8_t buffer[packet_max_datasize(handle)], *ptr = data;
 	uint16_t result;
 	uint32_t data_len;
+	size_t offset = 0;
+	const char *phase = "build";
 	if (total_bytes) *total_bytes = 0;
 
 	if ( (ret = service_connect(handle, 0x4060)) )
@@ -90,9 +104,13 @@ int nspire_file_read(nspire_handle_t *handle, const char *path,
 			0x0701, path)) )
 		goto end;
 
