From 4dc3d3e4c7f51030017435b86d2cb14a997b50a7 Mon Sep 17 00:00:00 2001
From: cx2-ag <cx2-ag@users.noreply.github.com>
Date: Tue, 8 Sep 2026 00:08:15 -0400
Subject: [PATCH 09/11] Preserve partial USB reads on timeout

---
 src/cx2.cpp         |  66 ++++++++++-----------------
 tests/transport.cpp | 109 +++++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 131 insertions(+), 44 deletions(-)

diff --git a/src/cx2.cpp b/src/cx2.cpp
index 2da664c..43a7a3a 100644
--- a/src/cx2.cpp
+++ b/src/cx2.cpp
@@ -167,57 +167,39 @@ static int readPacket(usb_device_t *handle, NNSEMessage *message, int maxlen, Pa
 	if(maxlen < sizeof(NNSEMessage))
 		return -NSPIRE_ERR_INVALID;
 
-	int transferred = 0;
 	memset(message, 0, sizeof(NNSEMessage));
-	auto timeout = remainingTimeout(deadline, 5000);
-	if(!timeout) {
-		nspire_trace("usb phase=read direction=in reason=deadline remaining_ms=0");
-		return -NSPIRE_ERR_TIMEOUT;
-	}
-	int r = tracedTransfer(handle, handle->ep_in, reinterpret_cast<unsigned char*>(message), maxlen, &transferred, timeout, deadline, "read");
-#ifdef DEBUG
-	std::cerr << "NNSE read: status=" << r << " transferred=" << transferred
-		<< " capacity=" << maxlen << " length=" << ntohs(message->length) << '\n';
-#endif
-
-	if(r < 0)
-		return usb_error(r);
-	if(!transferred)
-		return -NSPIRE_ERR_TIMEOUT;
-	if(transferred < sizeof(NNSEMessage))
-		return -NSPIRE_ERR_INVALPKT;
-
-	const auto completeLength = ntohs(message->length);
-	// Aligned frames carry one padding byte to terminate the USB transfer.
-	const int transferLength = completeLength + (completeLength % 64 == 0);
-
-	if(completeLength < sizeof(NNSEMessage)
-		|| transferLength > maxlen || transferred > transferLength)
-		return -NSPIRE_ERR_INVALPKT;
-
-	uint8_t *data = reinterpret_cast<uint8_t*>(message) + transferred;
-	auto remainingLength = transferLength - transferred;
-	while(remainingLength > 0)
+	int received = 0;
+	int completeLength = 0;
+	int transferLength = maxlen;
+	while(received < transferLength)
 	{
-		timeout = remainingTimeout(deadline, 1000);
+		const char *phase = received ? "continuation" : "read";
+		auto timeout = remainingTimeout(deadline, received ? 1000 : 5000);
 		if(!timeout) {
-			nspire_trace("usb phase=continuation direction=in reason=deadline remaining_ms=0");
+			nspire_trace("usb phase=%s direction=in reason=deadline remaining_ms=0", phase);
 			return -NSPIRE_ERR_TIMEOUT;
 		}
-		r = tracedTransfer(handle, handle->ep_in, data, remainingLength, &transferred, timeout, deadline, "continuation");
-#ifdef DEBUG
-		std::cerr << "NNSE continuation: status=" << r << " transferred=" << transferred
-			<< " remaining=" << remainingLength << '\n';
-#endif
-		if(r < 0)
+		int transferred = 0;
+		int capacity = transferLength - received;
+		int r = tracedTransfer(handle, handle->ep_in,
+			reinterpret_cast<unsigned char*>(message) + received, capacity,
+			&transferred, timeout, deadline, phase);
+		if(r < 0 && r != LIBUSB_ERROR_TIMEOUT)
 			return usb_error(r);
+		if(transferred < 0 || transferred > capacity)
+			return -NSPIRE_ERR_INVALPKT;
 		if(!transferred)
 			return -NSPIRE_ERR_TIMEOUT;
-		if(transferred < 0 || transferred > remainingLength)
+		received += transferred;
+		if(!completeLength && received >= sizeof(NNSEMessage)) {
+			completeLength = ntohs(message->length);
+			// Aligned frames carry one padding byte to terminate the USB transfer.
+			transferLength = completeLength + (completeLength % 64 == 0);
+			if(completeLength < sizeof(NNSEMessage) || transferLength > maxlen)
+				return -NSPIRE_ERR_INVALPKT;
+		}
+		if(received > transferLength)
 			return -NSPIRE_ERR_INVALPKT;
-		
-		data += transferred;
-		remainingLength -= transferred;
 	}
 
