+				"ldr r4, =savedlr_stack\n"
+				"ldr r5, =savedlr_stack_nr\n"
+				"ldr r6, [r5]\n"
+				"ldr lr, [r4, r6, lsl #2]\n"
+				"sub r6, r6, #1\n"
+				"str r6, [r5]\n"
+				"pop {r4-r6}\n"
+				"bx lr\n"
+				".ltorg" :: [nr] "i" (e_lua_pushnumber));
 }
 void lua_pushinteger(lua_State *p1, lua_Integer p2)
