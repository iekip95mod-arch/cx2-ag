diff --git a/ndless/src/resources/luaext.c b/ndless/src/resources/luaext.c
index 110ee75..33e540f 100644
--- a/ndless/src/resources/luaext.c
+++ b/ndless/src/resources/luaext.c
@@ -29,13 +29,22 @@
 static void *loaded[LUAEXT_MAX_MODULES];
 static unsigned loaded_next_index = 0;
 
+// The callback returns 0 both for a file that is not the one wanted and for the one that is and
+// would not load, and file_each cannot tell those apart, so the failure has to come back separately.
+struct require_state {
+	const char *filename;
+	int load_failed;
+};
+
 static int require_file_each_cb(const char *path, void *context) {
-	if (strcmp(strrchr(path, '/') + 1, (char*)context))
+	struct require_state *state = (struct require_state *)context;
+	if (strcmp(strrchr(path, '/') + 1, state->filename))
 		return 0;
 	loaded[loaded_next_index] = NULL;
 	if (ld_exec(path, &loaded[loaded_next_index]) != 0) {
 		// Loading failed or module returned failure
 		ld_free(loaded[loaded_next_index]);
+		state->load_failed = 1;
 		return 0;
 	}
  	loaded_next_index++; // found and loaded
@@ -44,6 +53,7 @@ static int require_file_each_cb(const char *path, void *context) {
 
 static int require(lua_State *L) {
 	char modulepath[FILENAME_MAX];
+	struct require_state state = { modulepath, 0 };
 	const char *name = luaL_checkstring(L, 1);
 	if (strlen(name) >= 30) goto require_not_found;
 	if (loaded_next_index >= LUAEXT_MAX_MODULES) {
@@ -51,7 +61,11 @@ static int require(lua_State *L) {
 		return 1;
 	}
 	sprintf(modulepath, "%s.luax.tns", name);
-	if (!file_each(get_documents_dir(), require_file_each_cb, modulepath)) {
+	if (!file_each(get_documents_dir(), require_file_each_cb, &state)) {
+		if (state.load_failed) {
+			luaL_error(L, "module " LUA_QS " was found but would not load", name);
+			return 1;
+		}
 require_not_found:
 		luaL_error(L, "module " LUA_QS " not found", name);
 		return 1;
