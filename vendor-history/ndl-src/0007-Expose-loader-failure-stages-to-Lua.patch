diff --git a/ndl/src/resources/luaext.c b/ndl/src/resources/luaext.c
index f1152ba..938f046 100644
--- a/ndl/src/resources/luaext.c
+++ b/ndl/src/resources/luaext.c
@@ -29,13 +29,23 @@
 static void *loaded[LUAEXT_MAX_MODULES];
 static unsigned loaded_next_index = 0;
 
+// The callback returns 0 both for a file that is not the one wanted and for the one that is and
+// would not load, and file_each cannot tell those apart, so the failure has to come back separately.
+struct require_state {
+	const char *filename;
+	int load_failed;
+	struct ld_diagnostic diagnostic;
+};
+
 static int require_file_each_cb(const char *path, void *context) {
-	if (strcmp(strrchr(path, '/') + 1, (char*)context))
+	struct require_state *state = (struct require_state *)context;
+	if (strcmp(strrchr(path, '/') + 1, state->filename))
 		return 0;
 	loaded[loaded_next_index] = NULL;
-	if (ld_exec(path, &loaded[loaded_next_index]) != 0) {
+	if (ld_exec_with_args_diagnostic(path, 0, NULL, &loaded[loaded_next_index], &state->diagnostic) != 0) {
 		// Loading failed or module returned failure
 		ld_free(loaded[loaded_next_index]);
+		state->load_failed = 1;
 		return 0;
 	}
  	loaded_next_index++; // found and loaded
@@ -44,6 +54,7 @@ static int require_file_each_cb(const char *path, void *context) {
 
 static int require(lua_State *L) {
 	char modulepath[FILENAME_MAX];
+	struct require_state state = { modulepath, 0, { "none", 0, 0 } };
 	const char *name = luaL_checkstring(L, 1);
 	if (strlen(name) >= 30) goto require_not_found;
 	if (loaded_next_index >= LUAEXT_MAX_MODULES) {
@@ -51,7 +62,14 @@ static int require(lua_State *L) {
 		return 1;
 	}
 	sprintf(modulepath, "%s.luax.tns", name);
-	if (!file_each(get_documents_dir(), require_file_each_cb, modulepath)) {
+	if (!file_each(get_documents_dir(), require_file_each_cb, &state)) {
+		if (state.load_failed) {
+			char detail[128];
+			snprintf(detail, sizeof(detail), "%s (code %d, bytes %lu)", state.diagnostic.stage,
+				state.diagnostic.code, (unsigned long)state.diagnostic.bytes);
+			luaL_error(L, "module " LUA_QS " was found but would not load: %s", name, detail);
+			return 1;
+		}
 require_not_found:
 		luaL_error(L, "module " LUA_QS " not found", name);
 		return 1;
diff --git a/ndl/src/resources/ndl.h b/ndl/src/resources/ndl.h
index 19ab2d3..9e6624c 100644
--- a/ndl/src/resources/ndl.h
+++ b/ndl/src/resources/ndl.h
@@ -77,9 +77,23 @@ enum e_ld_bin_format {
 	LD_ZEHN_BIN
 };
 extern enum e_ld_bin_format ld_bin_format;
+struct ld_diagnostic {
+	const char *stage;
+	int code;
+	size_t bytes;
+};
+static inline int ld_diagnostic_set(struct ld_diagnostic *diagnostic, const char *stage, int code, size_t bytes) {
+	if (diagnostic) {
+		diagnostic->stage = stage;
+		diagnostic->code = code;
+		diagnostic->bytes = bytes;
+	}
+	return code;
+}
 void ld_set_resident(void);
 int ld_exec(const char *path, void **resident_ptr);
 int ld_exec_with_args(const char *path, int argc, char *argv[], void **resident_ptr);
+int ld_exec_with_args_diagnostic(const char *path, int argc, char *argv[], void **resident_ptr, struct ld_diagnostic *diagnostic);
 void ld_free(void *resident_ptr);
 void plh_startup();
 
