# ARM GCC toolchain

FROM ndless/gcc

# make sure the package repository is up to date
RUN apt-get update

# install the dependencies
RUN apt-get install -y libgmp-dev libmpfr-dev libmpc-dev zlib1g-dev libtinfo-dev python2.7-dev libboost-program-options-dev xz-utils

RUN useradd -m -d /home/ndl -p ndl ndl && chsh -s /bin/bash ndl

ADD . /ndl-sdk

# build the toolchain, cleanup and set up the PATH
RUN chown -R ndl:ndl /ndl-sdk && cd /ndl-sdk/toolchain && su ndl -c "./build_toolchain.sh && rm -rf download build-binutils build binutils-* gcc-* gdb-* newlib-* "

ENV PATH /ndl-sdk/toolchain/install/bin:$PATH

