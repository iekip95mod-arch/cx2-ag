# Line endings are decided here rather than by whatever core.autocrlf each machine happens to set.
# An input setting normalized 127 vendored files to LF, which left the repository disagreeing with
# the upstream archives the provenance files name, and rewrote a preserved patch so that applying
# it would no longer reproduce what it recorded. Anything below that is a byte-exact record gets no
# end-of-line conversion at all. Sources we own stay LF in the repository.
* text=auto

/vendor/** -text
/vendor-history/** -text
/nps/third_party/** -text

# The one build output worth carrying. A runner that has to build the ARM cross compiler from
# source spends the best part of half an hour on it before it can compile a line of this project,
# and the Actions cache that normally covers that evicts after a week of not being touched. This is
# the only thing in the repository big enough to want LFS and slow enough to deserve it.
/vendor/toolchain/*.tar.zst filter=lfs diff=lfs merge=lfs -text

# The boot ROM and one flash image, so a runner that has neither can still boot the calculator and
# screenshot it. Both are byte-exact and both are past the 100 MiB file limit, so LFS rather than
# git. Only the two named in .gitignore are tracked: the rest of images/ is about 12 GB.
/images/boot1.img filter=lfs diff=lfs merge=lfs -text
/images/nspire-os.img filter=lfs diff=lfs merge=lfs -text

# The folder-hiding prototype recognizes factory files by size and CRC32, so its provenance copies
# and the evidence beside them are byte-exact records too. Normalizing themes.csv took it from the
# 191 bytes factory_manifest.h records to 188, which is a recognition failure in every clone.
/research/** -text
