new file mode 100644
--- /dev/null
+++ b/ndl-src/ndl-sdk/include/ndl_paths.h
@@ -0,0 +1,23 @@
+#ifndef NDL_PATHS_H
+#define NDL_PATHS_H
+
+#define NDL_DOCUMENTS_ROOT "/documents/ndl"
+#define NDL_DOCUMENTS_BOOT_RESOURCES "A:\\documents\\ndl\\ndl_resources.tns"
+
+#ifdef NDL_RELOCATED
+#define NDL_ROOT "/appdata/ndl"
+#define NDL_BOOT_RESOURCES "A:\\appdata\\ndl\\ndl_resources.tns"
+#ifndef GNU_AS
+#include <sys/stat.h>
+static inline const char *ndl_root(void) {
+	struct stat statbuf;
+	return stat(NDL_ROOT "/ndl_resources.tns", &statbuf) == 0
+		? NDL_ROOT : NDL_DOCUMENTS_ROOT;
+}
+#endif
+#else
+#define NDL_ROOT NDL_DOCUMENTS_ROOT
+#define NDL_BOOT_RESOURCES NDL_DOCUMENTS_BOOT_RESOURCES
+#endif
+
+#endif
diff --git a/ndl-src/ndl-sdk/libndls/config.c b/ndl-src/ndl-sdk/libndls/config.c
--- a/ndl-src/ndl-sdk/libndls/config.c
+++ b/ndl-src/ndl-sdk/libndls/config.c
@@ -22,6 +22,7 @@
  ****************************************************************************/
 
 #include <os.h>
+#include <ndl_paths.h>
 
 /* The config file is open whenever needed with cfg_open, and must be closed.
  * Each line of the file contains a key/value pair (key=value).
@@ -121,13 +122,23 @@
 }
 
 static int cfg_locate_cfg_file(char *dst_path, size_t dst_path_size) {
+	#ifdef NDL_RELOCATED
+	struct stat statbuf;
+	int len = snprintf(dst_path, dst_path_size, "%s/ndl.cfg.tns", ndl_root());
+	if (len < 0 || (size_t)len >= dst_path_size)
+		return 1;
+	return stat(dst_path, &statbuf) != 0;
+	#else
 	return locate("ndl.cfg.tns", dst_path, dst_path_size);
+	#endif
 }
 
 void cfg_open(void) {
 	static char path[300] = "";
+	#ifndef NDL_RELOCATED
 	struct stat statbuf;
 	if (path[0] == '\0' || stat(path, &statbuf) != 0)
+	#endif
 		if (cfg_locate_cfg_file(path, sizeof(path)))
 			return;
 
@@ -174,6 +185,10 @@
 void cfg_register_fileext(const char *ext, const char *prgm) {
 	char path[300];
 	if (cfg_locate_cfg_file(path, sizeof(path)))
+		#ifdef NDL_RELOCATED
+		snprintf(path, sizeof(path), "%s/ndl.cfg.tns", ndl_root());
+		#else
 		snprintf(path, sizeof(path), "%s%s", get_documents_dir(), "ndl/ndl.cfg.tns");
+		#endif
 	cfg_register_fileext_file(path, ext, prgm);
 }
